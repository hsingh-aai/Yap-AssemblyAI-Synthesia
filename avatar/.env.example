# Copy to .env and fill in. .env is gitignored.

# LiveKit Cloud. `lk cloud auth`, then `lk app env -w -d lk.env`, and copy
# these three across by hand.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Synthesia, Developers tab. Server-side only - never ship it to a browser.
SYNTHESIA_API_KEY=
# Kenji, the "Aristotle" face from Synthesia's RAG quickstart. Swap for one
# of yours; a custom avatar must be converted and polled to `completed` first.
AVATAR_ID=7572faa9-15da-400d-8227-ef1ab8932523

# The same key the firmware uses. Does the listening, the thinking (via the
# LLM Gateway) and supplies Jack's persona.
ASSEMBLYAI_API_KEY=
AAI_AGENT_ID=agent_921917929cb944e19960ffdfbd53f217
LLM_MODEL=gemini-3.5-flash-lite

# AssemblyAI's own TTS - no other vendor, no other key.
TTS_VOICE=49c443a4-8a1d-5f7e-b70b-98bdbd9823c3

# Needs LiveKit Cloud, so it stays off on a self-hosted server.
QUAIL_ENABLED=false
