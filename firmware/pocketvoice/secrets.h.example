// Copy to secrets.h and fill in. secrets.h is gitignored.
#pragma once

// Optional. This is the bench shortcut: a board flashed on your desk joins
// your desk's network without anyone touching the screen. Leave it as
// "your-network" and the device will ask on first boot instead, which is what
// you want for a board you are giving away. It is matched as a prefix, so a
// venue SSID with a location suffix still matches - give it enough of the
// name to be unambiguous, because a site running Guest and Guest-5G will hand
// you whichever is louder.
#define WIFI_SSID_PREFIX  "your-network"
#define WIFI_PASS         "your-password"

#define AAI_API_KEY       "your-assemblyai-api-key"
