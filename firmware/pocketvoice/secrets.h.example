// Copy to secrets.h and fill in. secrets.h is gitignored.
#pragma once

// Networks the device joins without being asked, matched as name prefixes,
// strongest first. Leave the placeholder and it asks on first boot instead,
// which is what you want for a unit you are giving away. Use a prefix, not
// the full name: iPhones name their hotspot with a curly apostrophe
// ("Someone’s iPhone") that a typed straight one will never match. And an
// iPhone hotspot must have Maximize Compatibility on - the ESP32-S3 is
// 2.4 GHz only.
#define WIFI_KNOWN { \
  {"your-network", "your-password"}, \
}

#define AAI_API_KEY       "your-assemblyai-api-key"
