#pragma once

// The firmware scans and joins the first network whose name starts with this,
// so a venue SSID with a location suffix still matches.
#define WIFI_SSID_PREFIX  "your-network"   // matched as a prefix, so pick enough of the name to be unambiguous
#define WIFI_PASS         "your-password"

#define AAI_API_KEY       "your-assemblyai-api-key"
